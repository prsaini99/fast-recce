# ─────────────────────────────────────────────────────────────
# FastRecce Frontend — Environment Variables
# Copy this file to `.env` only if you need to override the defaults.
# Vite injects any `VITE_*` variable into `import.meta.env` at build time.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Backend API base URL.
#   - Local dev: leave unset; Vite's dev server proxies /api/v1 to localhost:8000.
#   - Production (Vercel): set to your Render backend URL, e.g.:
#     VITE_API_URL=https://fastrecce-backend.onrender.com/api/v1
# Used for: starting search jobs, polling live jobs, enrichment, review/update
# actions. Read-only listings go directly to Supabase (below) to skip the
# Render cold-start.
VITE_API_URL=

# Supabase project — used by the frontend to query past searches, properties,
# outreach, and dashboard analytics directly via PostgREST. Always-on, no
# cold start. Anon key is public-safe; reads are gated by RLS policies
# created in alembic migration b3f5a9c1d702.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
