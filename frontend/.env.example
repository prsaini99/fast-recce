# ─────────────────────────────────────────────────────────────
# FastRecce Frontend — Environment Variables
# Copy this file to `.env` only if you need to override the defaults.
# Vite injects any `VITE_*` variable into `import.meta.env` at build time.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Backend API base URL.
#   - Local dev: leave unset; Vite's dev server proxies /api/v1 to localhost:8000.
#   - Production (Vercel): set to your Render backend URL, e.g.:
#     VITE_API_URL=https://fastrecce-backend.onrender.com/api/v1
VITE_API_URL=
